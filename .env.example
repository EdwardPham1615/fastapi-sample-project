# Every key this service reads. BaseAppSettings ignores unknown keys SILENTLY, so a
# misspelt key keeps its default with nothing to warn you — copy names from here.
# Nested groups use a double underscore: POSTGRES__HOST, KEYCLOAK__REALM, ...
# Full list of py-common keys: py-common's .env.example.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev
APP_NAME=user-profile-service
LOG_LEVEL=INFO
# ECS JSON logs everywhere by default. false = coloured console output for local reading.
LOG_JSON=true

# ── Server ───────────────────────────────────────────────────────────────────
# Used by `python -m src` / `make run` (py-common's runner).
SERVER__HOST=0.0.0.0
SERVER__PORT=8000

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Guards /internal/*. REQUIRED outside dev — the app refuses to start without it,
# because py-common's internal_router installs no guard at all when it is unset.
HTTP__INTERNAL_API_KEY=dev-key

# ── Postgres ─────────────────────────────────────────────────────────────────
# Port 5433: deployment/docker-compose.yaml maps it there so it does not collide
# with py-common's own infra on 5432.
POSTGRES__HOST=localhost
POSTGRES__PORT=5433
POSTGRES__USER=user_profile
POSTGRES__PASSWORD=user_profile
POSTGRES__DB=user_profile
# Run migrations on startup. Keep false in production; migrate from a deploy job.
POSTGRES__AUTO_MIGRATE=false

# ── Keycloak ─────────────────────────────────────────────────────────────────
# In dev this points at the app itself, which serves a fake Keycloak (see
# DEV_FAKE_KEYCLOAK). For a real Keycloak, change this URL and nothing else.
KEYCLOAK__SERVER_URL=http://localhost:8000
KEYCLOAK__REALM=app
KEYCLOAK__CLIENT_ID=user-profile-service
KEYCLOAK__CLIENT_SECRET=dev-secret
# Clients allowed to have obtained a user token (the azp claim). Set it even in dev
# so the check runs for real; the fake stamps this value into the tokens it mints.
KEYCLOAK__ALLOWED_AZP=["mobile-app"]
# Scopes for the service token (client_credentials). Leave empty unless needed.
KEYCLOAK__TOKEN_SCOPE=

# ── Dev only ─────────────────────────────────────────────────────────────────
DEV_FAKE_KEYCLOAK=true

# ── gRPC ─────────────────────────────────────────────────────────────────────
GRPC_ENABLED=false
GRPC_PORT=50051

# ── Telemetry ────────────────────────────────────────────────────────────────
# Off in dev: with no collector running, the exporter would retry and log forever.
OTEL__ENABLED=false

# ── Redis (idempotency keys, rate limiting) ──────────────────────────────────
REDIS_ENABLED=false
REDIS__URL=redis://localhost:6379/0
